// =========================================================
// PORTFOLIO — DIEGO MEDINA PAREDES
// Prisma Schema — PostgreSQL
// =========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum SkillCategory {
  FRONTEND
  BACKEND
  LANGUAGE_PROGRAMMING
  DATA_SCIENCE
  TOOLING
}

enum ProficiencyLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
  NATIVE
}

enum TimelineCategory {
  ACADEMIC
  LEADERSHIP
  RESEARCH
  INTERNATIONAL
  PROFESSIONAL
}

// ---------------------------------------------------------
// PROJECT
// Showcase de proyectos (GachaDex, Ruka, Modelos Data Science)
// ---------------------------------------------------------

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String? // Ej: "Machine Learning · Full-Stack"
  description String   @db.Text
  role        String? // Rol de Diego en el proyecto

  // Tarjetas asimétricas: define el tamaño/layout en el grid del frontend
  layoutSize  LayoutSize @default(MEDIUM)

  // Visuales
  coverImageUrl String?
  gallery       ProjectImage[]
  accentColor   String?  @default("#D8C9F0") // Color pastel para el aura/hover de la tarjeta

  // Links externos
  repoUrl    String?
  demoUrl    String?

  // Relaciones
  technologies ProjectTechnology[]

  featured  Boolean  @default(false)
  order     Int      @default(0) // Orden manual dentro del showcase

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([featured, order])
  @@map("projects")
}

enum LayoutSize {
  SMALL
  MEDIUM
  LARGE
  WIDE
}

model ProjectImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  order     Int      @default(0)

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@map("project_images")
}

// ---------------------------------------------------------
// SKILL
// Habilidades y lenguajes (React, NestJS, Python, C...)
// ---------------------------------------------------------

model Skill {
  id       String        @id @default(cuid())
  name     String        @unique
  category SkillCategory
  iconKey  String? // Referencia a un ícono en el frontend (ej: "react", "nestjs")
  level    Int           @default(80) // 0-100, para barras/gráficos de nivel

  order    Int           @default(0)

  projects ProjectTechnology[]

  @@map("skills")
}

// Tabla pivote explícita: permite metadata adicional por relación (ej. destacar tecnología clave)
model ProjectTechnology {
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String

  skill      Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId    String

  isPrimary  Boolean @default(false) // Ej: ML en GachaDex

  @@id([projectId, skillId])
  @@map("project_technologies")
}

// ---------------------------------------------------------
// LANGUAGE
// Idiomas: Español, Inglés, Alemán, Francés
// ---------------------------------------------------------

model Language {
  id          String           @id @default(cuid())
  name        String           @unique
  proficiency ProficiencyLevel
  order       Int              @default(0)

  @@map("languages")
}

// ---------------------------------------------------------
// TIMELINE EVENT
// Trayectoria académica interactiva (scroll timeline)
// ---------------------------------------------------------

model TimelineEvent {
  id          String            @id @default(cuid())
  title       String            // Ej: "Intercambio en Fachhochschule Münster"
  institution String?           // Ej: "Fachhochschule Münster, Alemania"
  description String            @db.Text
  category    TimelineCategory

  startDate   DateTime
  endDate     DateTime?         // null = evento puntual o en curso

  order       Int               @default(0) // Fuerza el orden en el eje del tiempo

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([order])
  @@map("timeline_events")
}

// ---------------------------------------------------------
// PROFILE
// Datos centrales del Hero Section (singleton lógico)
// ---------------------------------------------------------

model Profile {
  id          String   @id @default(cuid())
  fullName    String   @default("Diego Medina Paredes")
  headline    String   @default("Ingeniero en Informática Empresarial & Desarrollador Full-Stack")
  bio         String   @db.Text
  email       String?
  location    String?

  linkedinUrl String?
  githubUrl   String?

  updatedAt   DateTime @updatedAt

  @@map("profile")
}
